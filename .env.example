# Copy to .env and fill in. All are optional — the app also takes them in the UI.

# API keys (users can instead paste these into the sidebar)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# obs-websocket connection (defaults shown; password is auto-read from the local
# OBS config on macOS if you leave the sidebar field as-is)
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
